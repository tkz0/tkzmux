# tkzmux ZDOTDIR wrapper (installed as .zshrc). Read for an interactive shell, after /etc/zshrc
# (which sets HISTFILE=${ZDOTDIR:-$HOME}/.zsh_history -- into *our* dir, since ZDOTDIR is ours at
# that point) and before /etc/zlogin. See .zshenv for the mechanism.
#
# This file also puts $TKZMUX_BIN first on PATH -- deliberately last in the whole chain, so it
# wins over anything the user's own rc files (brew shellenv, ~/.local/bin/env, etc.) put there.
if [[ -n "${TKZMUX_ZDOTDIR:-}" && -n "${TKZMUX_USER_ZDOTDIR:-}" ]]; then
    if [[ -r "$TKZMUX_USER_ZDOTDIR/.zshrc" ]]; then
        ZDOTDIR="$TKZMUX_USER_ZDOTDIR"
        source "$TKZMUX_USER_ZDOTDIR/.zshrc"
        if [[ "$ZDOTDIR" != "$TKZMUX_USER_ZDOTDIR" ]]; then
            export TKZMUX_USER_ZDOTDIR="$ZDOTDIR"
        fi
    fi
    export ZDOTDIR="$TKZMUX_ZDOTDIR"

    # macOS's /etc/zshrc pointed HISTFILE into our ZDOTDIR before the user's rc ran. If the user's
    # file didn't set its own HISTFILE, redirect it back to their history so tkzmux shells share
    # it; if they set one themselves, leave it alone.
    if [[ "${HISTFILE:-}" == "$TKZMUX_ZDOTDIR/.zsh_history" ]]; then
        export HISTFILE="$TKZMUX_USER_ZDOTDIR/.zsh_history"
    fi

    # $TKZMUX_BIN first on PATH, exactly once.
    path=("$TKZMUX_BIN" ${path:#$TKZMUX_BIN})
    export PATH

    # Report the working directory to tkzmux as OSC 7 (`file://localhost/<percent-encoded path>`)
    # once now and on every `cd`/`pushd`/`popd`, so the sidebar title follows the shell (2026-09-08).
    # Only inside tkzmux (this whole block is), and `localhost` rather than $HOST on purpose: only
    # tkzmux reads it, and a hostname that does not match what the app resolves would be dropped.
    __tkzmux_report_cwd() {
        emulate -L zsh
        # Only to a terminal: a `zsh -c` with stdout piped (the wrapper tests, a script) must not
        # get escape bytes in its output. TKZMUX_OSC7_TO_STDOUT is the tests' way to see it.
        [[ -t 1 || -n "${TKZMUX_OSC7_TO_STDOUT:-}" ]] || return 0
        local LC_ALL=C
        local encoded="" ch
        local -i i
        for (( i = 1; i <= ${#PWD}; i++ )); do
            ch="${PWD[i]}"
            case "$ch" in
                [A-Za-z0-9/._~-]) encoded+="$ch" ;;
                *) printf -v ch '%%%02X' "'$ch"; encoded+="$ch" ;;
            esac
        done
        printf '\e]7;file://localhost%s\a' "$encoded"
    }
    autoload -Uz add-zsh-hook
    add-zsh-hook chpwd __tkzmux_report_cwd
    __tkzmux_report_cwd

    # Whatever the account picked in tkzmux needs re-exported (`CLAUDE_CONFIG_DIR`, or a future
    # agent's own variable) wins over the same name set in the user's own rc files, which ran
    # above -- that is the whole point of running this after them rather than before. TKZMUX_REEXPORT
    # names the variables (space separated); TKZMUX_ENV_<NAME> carries each one's value. Nothing
    # here when no account was chosen -- then the user's environment decides, and the shim reports
    # what it decided.
    if [[ -n "${TKZMUX_REEXPORT:-}" ]]; then
        for __tkzmux_reexport_name in ${=TKZMUX_REEXPORT}; do
            __tkzmux_reexport_var="TKZMUX_ENV_${__tkzmux_reexport_name}"
            if [[ -n "${(P)__tkzmux_reexport_var:-}" ]]; then
                export "${__tkzmux_reexport_name}=${(P)__tkzmux_reexport_var}"
            fi
        done
        unset __tkzmux_reexport_name __tkzmux_reexport_var
    fi
fi
